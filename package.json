{
  "name": "alimento",
  "version": "1.0.0",
  "description": "Alimento - A Feed Reader Application",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "test": "nyc mocha",
    "coveralls": "nyc report --reporter=text-lcov | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizcanet/alimento.git"
  },
  "keywords": [
    "feed",
    "reader",
    "rss"
  ],
  "author": "Luiz Henrique Canet Filho <me@luizca.net>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/luizcanet/alimento/issues"
  },
  "homepage": "https://github.com/luizcanet/alimento#readme",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "chai": "^5.1.2",
    "coveralls": "^3.1.1",
    "eslint": "^9.19.0",
    "eslint-plugin-mocha": "^10.5.0",
    "esm": "^3.2.25",
    "globals": "^15.14.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^11.1.0",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "^17.1.0"
  },
  "mocha": {
    "require": [
      "esm",
      "jsdom-global/register"
    ],
    "recursive": true,
    "extension": [
      "js"
    ]
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text"
    ],
    "all": true,
    "include": [
      "src/**/*.js"
    ]
  }
}
